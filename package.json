{
  "name": "spark-stack-academy",
  "version": "0.1.0",
  "private": true,
  "engines": { "node": ">=20" },
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "dev:founder": "npm run dev --workspace=@spark-stack/founder",
    "dev:admin": "npm run dev --workspace=@spark-stack/admin",
    "dev:instructor": "npm run dev --workspace=@spark-stack/instructor",
    "dev:student": "npm run dev --workspace=@spark-stack/student",
    "dev:institution": "npm run dev --workspace=@spark-stack/institution",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "devDependencies": {
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "typescript": "^5.7.3",
    "vite": "^6.0.7"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  }
}